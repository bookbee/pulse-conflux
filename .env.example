# ─── pulse-conflux configuration ─────────────────────────────────────────────
#
# Values below target the LOCAL development stack in ../pulse-infra. Bring it up
# with `make up` (the full profile includes Redis and the gateway that fills it).
#
# Every key name here is a CROSS-REPO CONTRACT. The authority is
# ../pulse-infra/docs/stack-contract.md.

# ── Redis source ─────────────────────────────────────────────────────────────
# From inside the pulse-infra Docker network use redis:6379 instead.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=pulse-local-not-a-secret
REDIS_DB=0

# TWO DIFFERENT PRIMITIVES, not one. The gateway writes:
#   - events and signals to STREAMS via XADD
#   - logs to a LIST via an EVALSHA'd Lua script that RPUSHes and EXPIREs
# The JSON envelope is identical across all three, so parsing can be shared —
# but consumption and acknowledgement cannot.
REDIS_STREAM_EVENTS=ingestion-events
REDIS_STREAM_SIGNALS=ingestion-signals
REDIS_LIST_LOGS=ingestion-logs

# Stream entries have EXACTLY ONE FIELD, named `data`, whose value is the JSON
# envelope. Do not expect one Redis field per envelope key.

# ── Consumer groups are yours ────────────────────────────────────────────────
# The gateway only XADDs; it never creates a consumer group. If this service
# uses XREADGROUP it owns XGROUP CREATE (with MKSTREAM) and all pending-entry
# and claim handling.
REDIS_CONSUMER_GROUP=pulse-conflux-local
REDIS_CONSUMER_NAME=conflux-1

# ── Envelope shape ───────────────────────────────────────────────────────────
# event_id, gateway_id, received_at (UTC RFC3339), retry_count, stream_name,
# payload, and event_header — which is present ONLY for JWT-authenticated
# gateway requests and ABSENT for API-key ones. Treat it as optional.

# ── Backpressure: there isn't any ────────────────────────────────────────────
# Both sources are lossy under lag and neither pushes back on the gateway:
#   - streams are trimmed to MAXLEN (approximate trimming upstream)
#   - the log list's Lua script DROPS the write outright once its cap is hit
# Falling behind means data loss upstream, not a slower producer. CONSUMER LAG
# IS THE METRIC THAT MATTERS. The local stack deliberately caps both at 10k
# (vs 100k in the gateway's own example) so you hit this in development.

# ── Forwarding targets (stubbed locally) ─────────────────────────────────────
# External integrations are out of local scope — stub them and assert on the
# calls rather than reaching real systems from a laptop.
FORWARD_ENABLED=false
FORWARD_TARGET_URL=http://localhost:9999/stub

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ══ Added with feature 001: event agent runtime ═══════════════════════════════
# Contract: specs/001-event-agent-runtime/contracts/configuration.md
# Constitution Principle I: every key below names what it contracts with.

# ── Runtime ──────────────────────────────────────────────────────────────────
# Health/metrics port. Contracts with the deployment's probe and scrape config.
HTTP_ADDR=:8090
# How long draining agents may finish in-flight work before exit.
SHUTDOWN_GRACE=15s
# Distinguishes two processes running the same agent set. Appended to every
# consumer name so pending-entry reclaim cannot claim entries in flight at
# another live instance. DEFAULTS TO HOSTNAME — set it only when running two
# processes on one host.
# CONFLUX_INSTANCE_ID=

# ── Agent registry ───────────────────────────────────────────────────────────
# Comma-separated agent ids. Empty is valid: the service starts, serves probes,
# and processes nothing. Ids are uppercased with non-alphanumerics folded to `_`
# to form the AGENT_<ID>_* keys below, and must be unique after that.
CONFLUX_AGENTS=events_ltr
#
# Per agent: _MODE is `stream` (continuous) or `periodic`. _SOURCE is a Redis key
# name from the stack contract; _SOURCE_KIND is `stream` or `list` and selects
# the consumption strategy. _INTERVAL is required for periodic agents only.
AGENT_EVENTS_LTR_ENABLED=true
AGENT_EVENTS_LTR_MODE=stream
AGENT_EVENTS_LTR_SOURCE=ingestion-events
AGENT_EVENTS_LTR_SOURCE_KIND=stream
AGENT_EVENTS_LTR_DESTINATIONS=ltr
AGENT_EVENTS_LTR_BATCH_SIZE=100
AGENT_EVENTS_LTR_BLOCK_TIMEOUT=5s

# ── Dispatch: bounded retry, then a recorded drop ────────────────────────────
# Liveness is preferred over completeness at the destination: an unavailable LTR
# or CEP engine must never become the reason this service falls behind and
# causes loss upstream. Exhausting the budget DROPS the event and records it.
DISPATCH_MAX_ATTEMPTS=3
# Per attempt, NOT total — this is what stops a hanging destination pinning an
# agent indefinitely.
DISPATCH_TIMEOUT=10s
DISPATCH_BACKOFF_INITIAL=200ms
DISPATCH_BACKOFF_MAX=5s
# Stubbed destinations. Real contracts are not yet specified for either.
DEST_LTR_URL=http://localhost:9999/stub/ltr
DEST_CEP_URL=http://localhost:9999/stub/cep

# ── Housekeeping ─────────────────────────────────────────────────────────────
# XAUTOCLAIM minimum idle time: what protects a live consumer's in-flight work.
PENDING_MIN_IDLE=5m
PENDING_RECLAIM_BATCH=100
# Consumers with no pending entries idle beyond this are retired. Without it,
# hostname-derived consumer names grow unbounded across redeploys.
CONSUMER_RETIRE_IDLE=24h
# Summary EMIT cadence only. The log agent drains continuously regardless: the
# gateway's Lua script REFUSES log writes at the list's 10k cap rather than
# trimming, so a slow drain makes this service the cause of upstream log loss.
SUMMARY_PERIOD=1h
SUMMARY_DESTINATION=summary
# Drain target: exceeding it raises an anomaly well before the 10k cap.
SUMMARY_MAX_LIST_DEPTH=2000

# ── Anomalies and support notification ───────────────────────────────────────
# Trips /readyz IMMEDIATELY. Note local stream caps are 10k.
LAG_THRESHOLD_ENTRIES=1000
# Gates the ANOMALY only, not readiness: readiness answers "are we behind now",
# a notification answers "is this worth waking someone for". 3m + up to one
# check interval keeps first notification inside the 5-minute target.
LAG_SUSTAINED_FOR=3m
# Fraction of dispatches dropped over the check window before support hears.
DROP_RATE_THRESHOLD=0.01
ANOMALY_CHECK_INTERVAL=1m
ANOMALY_NOTIFY_COOLDOWN=30m
ANOMALY_MAX_PER_HOUR=4
# Email is stubbed locally (Principle V): no test reaches a real mail server.
EMAIL_ENABLED=false
SMTP_ADDR=localhost:1025
# Required when EMAIL_ENABLED=true.
SUPPORT_EMAIL_TO=
SUPPORT_EMAIL_FROM=pulse-conflux@localhost
